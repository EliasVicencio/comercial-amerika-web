# ============================================
# .gitignore - Comercial Amerika (sitio estático)
# ============================================

# --- Imágenes de respaldo / limpieza no publicada ---
_img-no-usadas/

# --- Documentos internos (no van al sitio público) ---
*.pdf
*.md

# --- Sistema operativo ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editores ---
.vscode/
.idea/
*.swp
*.swo

# --- Backups y temporales locales ---
*.bak
*.tmp
*~
_backup/
tmp/

# --- Node (por si agregamos build tools algún día) ---
node_modules/
package-lock.json

# --- Logs ---
*.log

# --- Datos sensibles / credenciales (nunca subir) ---
*-secret.php
config.local.*
credentials.*
.env
.env.*